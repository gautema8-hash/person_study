# 依赖与构建产物
node_modules/
dist/
backend/out/
backend/server.log

# 系统/编辑器
.DS_Store
*.log
.idea/
.vscode/

# Android（frontend/android/.gitignore 已含模板规则，这里兜底）
**/local.properties
**/.gradle/
**/build/
*.apk
*.keystore
!debug.keystore

# 签名密钥不入库（本地保留 frontend/android/rszx-release.keystore 与 keystore.properties）
keystore.properties
**/rszx-release.keystore

# installers 中的成品包允许入库
!installers/**/*.apk
!installers/**/*.zip
